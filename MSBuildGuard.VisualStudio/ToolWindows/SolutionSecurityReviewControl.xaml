<UserControl x:Class="MSBuildGuard.VisualStudio.ToolWindows.SolutionSecurityReviewControl"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d"
			 d:DesignHeight="450"
			 d:DesignWidth="800">
	<Grid Margin="12" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="2*" />
			<RowDefinition Height="5" />
			<RowDefinition Height="*" MinHeight="60" />
		</Grid.RowDefinitions>

		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<Image Source="/MSBuildguard.VisualStudio;component/ToolWindows/AppShieldGreen-24x24.png"
				   Width="24"
				   Height="24"
				   Margin="4,4,12,0"
				   VerticalAlignment="Top" HorizontalAlignment="Left"/>
			
			<TextBlock Text="MSBuild Guard - Solution Security Review"
					   FontSize="18"
					   FontWeight="SemiBold"
					   Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" Margin="30,4,8,0" />

			<TextBlock Grid.Column="1"
					   Text="{Binding Summary.TargetNameDisplay}"
					   ToolTip="{Binding Summary.TargetPathDisplay}"
					   Margin="12,2,8,0"
					   VerticalAlignment="Center"
					   FontSize="14"
					   FontWeight="SemiBold"
					   Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
		</Grid>

		<Grid Grid.Row="1" Margin="0,10,0,10">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<StackPanel Orientation="Vertical">
				<StackPanel Orientation="Horizontal">
					<TextBlock Text="Project:" FontWeight="Bold" Width="80" VerticalAlignment="Center" Margin="8,0,0,0" />
					<ComboBox Width="220"
							  Margin="0,0,0,0"
							  ItemsSource="{Binding ProjectOptions}"
							  SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
							  DisplayMemberPath="Name" />
				</StackPanel>
				<StackPanel Orientation="Horizontal" Margin="8,2,0,0">
					<TextBlock Text="Target:" FontWeight="Bold" Width="80" VerticalAlignment="Center" />
					<TextBlock Text="{Binding Summary.TargetPathDisplay}" ToolTip="{Binding Summary.TargetPathDisplay}" VerticalAlignment="Center" />
				</StackPanel>
				<StackPanel Orientation="Horizontal" Margin="8,2,0,0">
					<TextBlock Text="Risk score:" FontWeight="Bold" Width="80" VerticalAlignment="Center" />
					<TextBlock Text="{Binding Summary.RiskIndicator}"
							   Foreground="{Binding Summary.RiskIndicatorBrush}"
							   FontSize="13"
							   Margin="0,0,6,0"
							   VerticalAlignment="Center" />
					<TextBlock Text="{Binding Summary.RiskScore}" VerticalAlignment="Center" Foreground="{Binding Summary.RiskIndicatorBrush}"/>
				</StackPanel>
				<StackPanel Orientation="Horizontal" Margin="8,2,0,0">
					<TextBlock Text="Action:" FontWeight="Bold" Width="80" VerticalAlignment="Center" />
					<TextBlock Text="{Binding Summary.RecommendedAction}" VerticalAlignment="Center" />
				</StackPanel>
			</StackPanel>

			<Button Grid.Column="1"
					Content="Scan/Rescan"
					Width="95"
					Margin="10,0,6,0"
					HorizontalAlignment="Right"
					Click="OnRescanClick" Height="30" VerticalAlignment="Top" />

			<Button Grid.Column="2"
					Content="Edit Policy"
					Width="90"
					Margin="0,0,8,0"
					HorizontalAlignment="Right"
					Click="OnEditPolicyClick" Height="30" VerticalAlignment="Top" />
		</Grid>

		<DataGrid Grid.Row="2"
				  ItemsSource="{Binding Findings}"
				  SelectedItem="{Binding SelectedFinding, Mode=TwoWay}"
				  AutoGenerateColumns="False"
				  IsReadOnly="True"
				  CanUserAddRows="False"
				  CanUserDeleteRows="False"
				  MouseDoubleClick="OnFindingsMouseDoubleClick"
				  Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Margin="8,0,8,4">
			<DataGrid.ContextMenu>
				<ContextMenu>
					<MenuItem Header="Trust Issue"
							  Click="OnTrustFindingClick"
							  IsEnabled="{Binding PlacementTarget.SelectedItem.CanTrust, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
					<MenuItem Header="Remove Trust"
							  Click="OnRemoveTrustFindingClick"
							  IsEnabled="{Binding PlacementTarget.SelectedItem.CanRemoveTrust, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
					<Separator />
					<MenuItem Header="Trust Owning Assembly"
							  Click="OnTrustAssemblyClick"
							  IsEnabled="{Binding PlacementTarget.SelectedItem.CanTrustAssembly, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
				</ContextMenu>
			</DataGrid.ContextMenu>
			<DataGrid.Columns>
				<DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="90" />
				<DataGridTextColumn Header="Rule" Binding="{Binding RuleId}" Width="90" />
				<DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="2*" />
				<DataGridTextColumn Header="File" Binding="{Binding FilePathDisplay}" Width="2*" />
				<DataGridTextColumn Header="Line" Binding="{Binding Line}" Width="70" />
				<DataGridTextColumn Header="Policy" Binding="{Binding PolicyAction}" Width="120" />
				<DataGridCheckBoxColumn Header="Trusted" Binding="{Binding IsTrusted}" Width="80" />
				<DataGridCheckBoxColumn Header="New" Binding="{Binding IsNewComparedWithBaseline}" Width="80" />
			</DataGrid.Columns>
		</DataGrid>

		<GridSplitter Grid.Row="3"
					  Height="5"
					  HorizontalAlignment="Stretch"
					  VerticalAlignment="Center"
					  Background="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" />

		<Grid Grid.Row="4" Margin="0,4,0,0">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>

			<TextBlock Text="Reasoning:"
					   FontWeight="SemiBold"
					   Margin="8,0,0,4"
					   Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />

			<TextBox Grid.Row="1"
					 Text="{Binding ReasoningText, Mode=OneWay}"
					 IsReadOnly="True"
					 TextWrapping="Wrap"
					 VerticalScrollBarVisibility="Auto"
					 HorizontalScrollBarVisibility="Disabled"
					 FontFamily="Consolas"
					 FontSize="11"
					 Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
					 Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
					 BorderThickness="1" Margin="8,0,8,4" />
		</Grid>
	</Grid>
</UserControl>
