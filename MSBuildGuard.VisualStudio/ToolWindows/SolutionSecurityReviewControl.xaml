<UserControl x:Class="MSBuildGuard.VisualStudio.ToolWindows.SolutionSecurityReviewControl"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
			 xmlns:platformUi="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
			 mc:Ignorable="d"
			 d:DesignHeight="450"
			 d:DesignWidth="800">
	<UserControl.Resources>
		<ResourceDictionary>
			<SolidColorBrush x:Key="EditorBackgroundBrush" Color="#0B0F19" />
			<SolidColorBrush x:Key="HeaderStartBrush" Color="#1E293B" />
			<SolidColorBrush x:Key="HeaderEndBrush" Color="#0F172A" />
			<SolidColorBrush x:Key="CardBackgroundBrush" Color="#111827" />
			<SolidColorBrush x:Key="BorderBrushDark" Color="#2A3447" />
			<SolidColorBrush x:Key="PrimaryTextBrush" Color="#F1F5F9" />
			<SolidColorBrush x:Key="SecondaryTextBrush" Color="#94A3B8" />
			<SolidColorBrush x:Key="AccentBrush" Color="#3B82F6" />

			<LinearGradientBrush x:Key="HeaderBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
				<GradientStop Color="{Binding Color, Source={StaticResource HeaderStartBrush}}" Offset="0" />
				<GradientStop Color="{Binding Color, Source={StaticResource HeaderEndBrush}}" Offset="1" />
			</LinearGradientBrush>

			<LinearGradientBrush x:Key="PrimaryButtonBrush" StartPoint="0,0" EndPoint="1,1">
				<GradientStop Color="#10B981" Offset="0" />
				<GradientStop Color="#059669" Offset="1" />
			</LinearGradientBrush>

			<Style TargetType="TextBlock">
				<Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
			</Style>

			<Style x:Key="CardBorderStyle" TargetType="Border">
				<Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
				<Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}" />
				<Setter Property="BorderThickness" Value="1" />
				<Setter Property="CornerRadius" Value="16" />
				<Setter Property="Padding" Value="16" />
			</Style>

			<Style x:Key="FieldLabelStyle" TargetType="TextBlock">
				<Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
				<Setter Property="FontSize" Value="12" />
				<Setter Property="FontWeight" Value="SemiBold" />
			</Style>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <Style x:Key="EditorComboToggleStyle" TargetType="ToggleButton">
				<Setter Property="Focusable" Value="False" />
				<Setter Property="Background" Value="Transparent" />
				<Setter Property="BorderThickness" Value="0" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="ToggleButton">
							<Border Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" />
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>

			<Style x:Key="EditorComboItemStyle" TargetType="ComboBoxItem">
				<Setter Property="Background" Value="#0F172A" />
				<Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
				<Setter Property="BorderBrush" Value="Transparent" />
				<Setter Property="BorderThickness" Value="0" />
				<Setter Property="Padding" Value="8,4" />
				<Setter Property="HorizontalContentAlignment" Value="Stretch" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="ComboBoxItem">
							<Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
								<ContentPresenter />
							</Border>
							<ControlTemplate.Triggers>
								<Trigger Property="IsHighlighted" Value="True">
									<Setter TargetName="Bd" Property="Background" Value="#1E293B" />
									<Setter Property="Foreground" Value="#FFFFFF" />
								</Trigger>
								<Trigger Property="IsSelected" Value="True">
									<Setter TargetName="Bd" Property="Background" Value="#1E293B" />
									<Setter Property="Foreground" Value="#FFFFFF" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>

			<Style x:Key="EditorComboStyle" TargetType="ComboBox">
				<Setter Property="SnapsToDevicePixels" Value="True" />
				<Setter Property="OverridesDefaultStyle" Value="True" />
				<Setter Property="Background" Value="#0F172A" />
				<Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
				<Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}" />
				<Setter Property="BorderThickness" Value="1" />
				<Setter Property="Padding" Value="8,4" />
				<Setter Property="MinHeight" Value="34" />
				<Setter Property="ItemContainerStyle" Value="{DynamicResource EditorComboItemStyle}" />
				<Setter Property="HorizontalContentAlignment" Value="Left" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="ComboBox">
							<Grid>
								<Border x:Name="ClosedStateBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" />
								<ContentPresenter Margin="10,2,30,2" VerticalAlignment="Center" HorizontalAlignment="Left" RecognizesAccessKey="True" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
								<Path Data="M 0 0 L 4 4 L 8 0" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False" />
								<ToggleButton x:Name="ToggleButton" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Style="{DynamicResource EditorComboToggleStyle}" Background="Transparent" BorderThickness="0" Panel.ZIndex="10" />
								<Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PlacementTarget="{Binding ElementName=ToggleButton}">
									<Border x:Name="DropDownBorder" Background="#0F172A" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="260">
										<ScrollViewer Background="#0F172A" SnapsToDevicePixels="True" CanContentScroll="True">
											<StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
										</ScrollViewer>
									</Border>
								</Popup>
							</Grid>
							<ControlTemplate.Triggers>
								<Trigger Property="IsDropDownOpen" Value="True">
									<Setter TargetName="ClosedStateBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>

			<Style x:Key="SecondaryActionButtonStyle" TargetType="Button">
				<Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
				<Setter Property="Background" Value="#1E293B" />
				<Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}" />
				<Setter Property="BorderThickness" Value="1" />
				<Setter Property="Padding" Value="16,8" />
				<Setter Property="FontWeight" Value="SemiBold" />
				<Setter Property="Cursor" Value="Hand" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="Button">
							<Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
								<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
							</Border>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>

			<Style x:Key="PrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryActionButtonStyle}">
				<Setter Property="Background" Value="{StaticResource PrimaryButtonBrush}" />
				<Setter Property="BorderBrush" Value="Transparent" />
			</Style>

			<Style x:Key="RiskIndicatorStyle" TargetType="TextBlock">
				<Style.Triggers>
					<DataTrigger Binding="{Binding Summary.RiskLevel}" Value="High">
						<Setter Property="Foreground" Value="#EF4444" />
					</DataTrigger>
					<DataTrigger Binding="{Binding Summary.RiskLevel}" Value="Medium">
						<Setter Property="Foreground" Value="#EAB308" />
					</DataTrigger>
					<DataTrigger Binding="{Binding Summary.RiskLevel}" Value="Low">
						<Setter Property="Foreground" Value="#10B981" />
					</DataTrigger>
				</Style.Triggers>
			</Style>
			<Style TargetType="CheckBox" BasedOn="{StaticResource {x:Static vsshell:VsResourceKeys.CheckBoxStyleKey}}" />
			<Style TargetType="ContextMenu" BasedOn="{StaticResource {x:Static vsshell:VsResourceKeys.ContextMenuStyleKey}}" />
			<Style TargetType="DataGrid">
				<Setter Property="Background" Value="#0F172A" />
				<Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
				<Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}" />
				<Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrushDark}" />
				<Setter Property="VerticalGridLinesBrush" Value="{StaticResource BorderBrushDark}" />
				<Setter Property="RowBackground" Value="#0F172A" />
				<Setter Property="AlternatingRowBackground" Value="#111827" />
				<Setter Property="HeadersVisibility" Value="Column" />
			</Style>
			<Style TargetType="DataGridColumnHeader">
				<Setter Property="Background" Value="#1E293B" />
				<Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
				<Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}" />
				<Setter Property="BorderThickness" Value="0,0,1,1" />
				<Setter Property="Padding" Value="6,4" />
			</Style>
			<Style TargetType="DataGridRow">
				<Setter Property="Background" Value="#0F172A" />
				<Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
			</Style>
			<Style TargetType="DataGridCell">
				<Setter Property="Background" Value="Transparent" />
				<Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
				<Style.Triggers>
					<Trigger Property="IsSelected" Value="True">
						<Setter Property="Background" Value="#1E293B" />
						<Setter Property="Foreground" Value="#FFFFFF" />
					</Trigger>
				</Style.Triggers>
			</Style>
		</ResourceDictionary>
	</UserControl.Resources>
	<Grid Margin="12" Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="2*" />
			<RowDefinition Height="5" />
			<RowDefinition Height="*" MinHeight="60" />
		</Grid.RowDefinitions>

		<Border Style="{StaticResource CardBorderStyle}" Background="{StaticResource HeaderBackgroundBrush}">
			<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<Image Source="/MSBuildguard.VisualStudio;component/ToolWindows/AppShieldGreen-24x24.png"
				   Width="24"
				   Height="24"
				   Margin="4,4,12,0"
				   VerticalAlignment="Top" HorizontalAlignment="Left"/>
			
			<TextBlock Text="MSBuild Guard: Solution Security Review"
					   FontSize="22"
					   FontWeight="SemiBold"
					   Margin="30,4,8,0" Style="{StaticResource SectionTitleStyle}"/>

			<TextBlock Grid.Column="1"
					   Text="{Binding Summary.TargetNameDisplay}"
					   ToolTip="{Binding Summary.TargetPathDisplay}"
					   Margin="12,2,8,0"
					   VerticalAlignment="Center"
					   FontSize="14"
					   FontWeight="SemiBold" />
			</Grid>
		</Border>

		<Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,10,0,10">
			<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<StackPanel Orientation="Vertical">
				<StackPanel Orientation="Horizontal">
					<TextBlock Text="Project:" Style="{StaticResource FieldLabelStyle}" Width="80" VerticalAlignment="Center" Margin="8,0,0,0" />
					<ComboBox Width="220"
							  Margin="0"
							  Style="{StaticResource EditorComboStyle}"
							  ItemsSource="{Binding ProjectOptions}"
							  SelectedItem="{Binding SelectedProject, Mode=TwoWay}">
						<ComboBox.ItemTemplate>
							<DataTemplate>
								<TextBlock Text="{Binding Name}" />
							</DataTemplate>
						</ComboBox.ItemTemplate>
					</ComboBox>
				</StackPanel>
				<StackPanel Orientation="Horizontal" Margin="8,2,0,0">
					<TextBlock Text="Target:" Style="{StaticResource FieldLabelStyle}" Width="80" VerticalAlignment="Center" />
					<TextBlock Text="{Binding Summary.TargetPathDisplay}" ToolTip="{Binding Summary.TargetPathDisplay}" VerticalAlignment="Center" />
				</StackPanel>
				<StackPanel Orientation="Horizontal" Margin="8,2,0,0">
					<TextBlock Text="Risk score:" Style="{StaticResource FieldLabelStyle}" Width="80" VerticalAlignment="Center" />
					<TextBlock Text="{Binding Summary.RiskIndicator}"
							   Style="{StaticResource RiskIndicatorStyle}"
							   FontSize="13"
							   Margin="0,0,6,0"
							   VerticalAlignment="Center" />
					<TextBlock Text="{Binding Summary.RiskScoreDisplay}"
							   Style="{StaticResource RiskIndicatorStyle}"
							   VerticalAlignment="Center" />
				</StackPanel>
				<StackPanel Orientation="Horizontal" Margin="8,2,0,0">
					<TextBlock Text="Action:" Style="{StaticResource FieldLabelStyle}" Width="80" VerticalAlignment="Center" />
					<TextBlock Text="{Binding Summary.RecommendedAction}" VerticalAlignment="Center" />
				</StackPanel>
			</StackPanel>

			<Button Grid.Column="1"
					Content="Scan/Rescan"
					Width="110"
					Margin="10,0,6,0"
					Style="{StaticResource SecondaryActionButtonStyle}"
					HorizontalAlignment="Right"
					Click="OnRescanClick"
					Height="34"
					VerticalAlignment="Top" />

			<Button Grid.Column="2"
					Content="Edit Policy"
					Width="110"
					Margin="0,0,8,0"
					Style="{StaticResource PrimaryActionButtonStyle}"
					HorizontalAlignment="Right"
					Click="OnEditPolicyClick"
					Height="34"
					VerticalAlignment="Top" />

			<CheckBox Grid.Row="1"
					  Grid.Column="1"
					  Grid.ColumnSpan="2"
					  Content="only untrusted issues"
					  Margin="10,8,8,0"
					  HorizontalAlignment="Right"
					  VerticalAlignment="Center"
					  IsChecked="{Binding OnlyUntrustedIssues, Mode=TwoWay}" />
			</Grid>
		</Border>

		<Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="10" Margin="0,0,0,4">
			<DataGrid x:Name="FindingsGrid"
				  ItemsSource="{Binding Findings}"
				  SelectedItem="{Binding SelectedFinding, Mode=TwoWay}"
				  AutoGenerateColumns="False"
				  IsReadOnly="True"
				  CanUserAddRows="False"
				  CanUserDeleteRows="False"
				  CanUserSortColumns="True"
				  MouseDoubleClick="OnFindingsMouseDoubleClick"
				  Margin="0">
			<DataGrid.ContextMenu>
				<ContextMenu>
					<MenuItem Header="Trust Issue"
							  Click="OnTrustFindingClick"
							  IsEnabled="{Binding PlacementTarget.SelectedItem.CanTrust, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
					<MenuItem Header="Remove Trust"
							  Click="OnRemoveTrustFindingClick"
							  IsEnabled="{Binding PlacementTarget.SelectedItem.CanRemoveTrust, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
					<Separator />
					<MenuItem Header="Trust Owning Assembly"
							  Click="OnTrustAssemblyClick"
							  IsEnabled="{Binding PlacementTarget.SelectedItem.CanTrustAssembly, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
						<Separator />
						<MenuItem Header="Assembly Information..."
								  Click="OnAssemblyInformationClick"
								  IsEnabled="{Binding PlacementTarget.SelectedItem.CanTrustAssembly, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
				</ContextMenu>
			</DataGrid.ContextMenu>
			<DataGrid.Columns>
				<DataGridTemplateColumn Header="Severity" Width="55" SortMemberPath="SeveritySortRank">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<Image Source="{Binding SeverityIconPath}" Width="16" Height="16" ToolTip="{Binding Severity}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<DataGridTextColumn Header="Rule" Binding="{Binding RuleId}" Width="90" />
				<DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="1*" />
				<DataGridTextColumn Header="File" Binding="{Binding FilePathDisplay}" Width="2*" />
				<DataGridTextColumn Header="Line" Binding="{Binding Line}" Width="50" />
				<DataGridTextColumn Header="Policy" Binding="{Binding PolicyAction}" Width="120" />
				<DataGridCheckBoxColumn x:Name="TrustedColumn" Header="Trusted" Binding="{Binding IsTrusted}" Width="50" />
				<DataGridCheckBoxColumn Header="New" Binding="{Binding IsNewComparedWithBaseline}" Width="50" />
			</DataGrid.Columns>
			</DataGrid>
		</Border>

		<GridSplitter Grid.Row="3"
					  Height="5"
					  HorizontalAlignment="Stretch"
					  VerticalAlignment="Center"
					  Background="{DynamicResource {x:Static vsshell:VsBrushes.PanelSeparatorKey}}" />

		<Border Grid.Row="4" Style="{StaticResource CardBorderStyle}" Margin="0,4,0,0" Padding="10">
			<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>

			<TextBlock Text="Reasoning:"
					   FontWeight="SemiBold"
					   Margin="0,0,0,4"
					   Style="{StaticResource FieldLabelStyle}" />

			<TextBox Grid.Row="1"
					 Text="{Binding ReasoningText, Mode=OneWay}"
					 IsReadOnly="True"
					 TextWrapping="Wrap"
					 VerticalScrollBarVisibility="Auto"
					 HorizontalScrollBarVisibility="Disabled"
					 FontFamily="Consolas"
					 FontSize="11"
					 Background="#0F172A"
					 Foreground="{StaticResource PrimaryTextBrush}"
					 BorderBrush="{StaticResource BorderBrushDark}"
					 BorderThickness="1"
					 Margin="0" />
			</Grid>
		</Border>
	</Grid>
</UserControl>
