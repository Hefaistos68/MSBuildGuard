<UserControl x:Class="MSBuildGuard.VisualStudio.ToolWindows.PolicyEditorControl"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
			 xmlns:platformUi="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
			 mc:Ignorable="d"
			 d:DesignHeight="600"
			 d:DesignWidth="700">
	<UserControl.Resources>
		<ResourceDictionary>
			<BooleanToVisibilityConverter x:Key="BoolToVis" />

			<Style TargetType="TextBlock">
				<Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>
			</Style>

			<Style x:Key="EditorComboToggleStyle" TargetType="ToggleButton">
				<Setter Property="Focusable" Value="False" />
				<Setter Property="Background" Value="Transparent" />
				<Setter Property="BorderThickness" Value="0" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="ToggleButton">
							<Border Background="{TemplateBinding Background}"
									BorderThickness="{TemplateBinding BorderThickness}" />
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>

			<Style x:Key="PolicyPathLinkStyle" TargetType="TextBlock">
				<Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ControlLinkTextKey}}"/>
				<Setter Property="TextDecorations" Value="Underline"/>
				<Setter Property="Cursor" Value="Hand"/>
				<Style.Triggers>
					<Trigger Property="IsMouseOver" Value="True">
						<Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ControlLinkTextHoverKey}}"/>
					</Trigger>
				</Style.Triggers>
			</Style>

			<Style x:Key="CardBorderStyle" TargetType="Border">
				<Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.GridHeadingBackgroundKey}}" />
				<Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsshell:VsBrushes.PanelBorderKey}}" />
				<Setter Property="BorderThickness" Value="1" />
				<Setter Property="CornerRadius" Value="16" />
				<Setter Property="Padding" Value="20" />
			</Style>

			<Style x:Key="SectionTitleStyle" TargetType="TextBlock">
				<Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
				<Setter Property="FontSize" Value="28" />
				<Setter Property="FontWeight" Value="SemiBold" />
				<Setter Property="Margin" Value="0,0,0,8" />
			</Style>

			<Style x:Key="FieldLabelStyle" TargetType="TextBlock">
				<Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}" />
				<Setter Property="FontSize" Value="12" />
				<Setter Property="FontWeight" Value="SemiBold" />
				<Setter Property="Margin" Value="0,0,0,4" />
			</Style>

			<Style x:Key="EditorComboStyle" TargetType="ComboBox">
				<Setter Property="SnapsToDevicePixels" Value="True" />
				<Setter Property="OverridesDefaultStyle" Value="True" />
				<Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
				<Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
				<Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.ComboBoxBackgroundKey}}" />
				<Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}" />
				<Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsshell:VsBrushes.ComboBoxBorderKey}}" />
				<Setter Property="BorderThickness" Value="1" />
				<Setter Property="Padding" Value="8,4" />
				<Setter Property="MinHeight" Value="34" />
				<Setter Property="Margin" Value="0,0,0,12" />
				<Setter Property="ItemContainerStyle" Value="{DynamicResource EditorComboItemStyle}" />
				<Setter Property="HorizontalContentAlignment" Value="Left" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="ComboBox">
							<Grid>
								<Border x:Name="ClosedStateBorder"
										Background="{TemplateBinding Background}"
										BorderBrush="{TemplateBinding BorderBrush}"
										BorderThickness="{TemplateBinding BorderThickness}"
										CornerRadius="8" />

								<ContentPresenter x:Name="ContentSite"
												  Margin="10,2,30,2"
												  VerticalAlignment="Center"
												  HorizontalAlignment="Left"
												  RecognizesAccessKey="True"
												  IsHitTestVisible="False"
												  Content="{TemplateBinding SelectionBoxItem}"
												  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />

								<Path Data="M 0 0 L 4 4 L 8 0"
									  Stroke="{TemplateBinding Foreground}"
									  StrokeThickness="1.5"
									  HorizontalAlignment="Right"
									  VerticalAlignment="Center"
									  Margin="0,0,12,0"
									  IsHitTestVisible="False" />

								<ToggleButton x:Name="ToggleButton"
											Focusable="False"
											IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
											ClickMode="Press"
											HorizontalAlignment="Stretch"
											VerticalAlignment="Stretch"
											Style="{DynamicResource EditorComboToggleStyle}"
											Background="Transparent"
											BorderThickness="0"
											Panel.ZIndex="10" />

								<Popup x:Name="PART_Popup"
									   Placement="Bottom"
									   IsOpen="{TemplateBinding IsDropDownOpen}"
									   AllowsTransparency="True"
									   Focusable="False"
									   PlacementTarget="{Binding ElementName=ToggleButton}"
									   PopupAnimation="Slide">
									<Border x:Name="DropDownBorder"
											Background="{DynamicResource {x:Static vsshell:VsBrushes.ComboBoxBackgroundKey}}"
											BorderBrush="{TemplateBinding BorderBrush}"
											BorderThickness="1"
											CornerRadius="8"
											MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
											MaxHeight="260">
										<ScrollViewer Background="{DynamicResource {x:Static vsshell:VsBrushes.ComboBoxBackgroundKey}}" SnapsToDevicePixels="True" CanContentScroll="True">
											<StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
										</ScrollViewer>
									</Border>
								</Popup>
							</Grid>
							<ControlTemplate.Triggers>
								<Trigger Property="HasItems" Value="False">
									<Setter TargetName="DropDownBorder" Property="MinHeight" Value="30" />
								</Trigger>
								<Trigger Property="IsDropDownOpen" Value="True">
									<Setter TargetName="ClosedStateBorder" Property="BorderBrush" Value="{DynamicResource {x:Static vsshell:VsBrushes.AccentMediumKey}}" />
								</Trigger>
								<Trigger Property="IsEnabled" Value="False">
									<Setter Property="Opacity" Value="0.7" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>

			<Style x:Key="EditorComboItemStyle" TargetType="ComboBoxItem">
				<Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.ComboBoxBackgroundKey}}" />
				<Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}" />
				<Setter Property="BorderBrush" Value="Transparent" />
				<Setter Property="BorderThickness" Value="0" />
				<Setter Property="Padding" Value="8,4" />
				<Setter Property="HorizontalContentAlignment" Value="Stretch" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="ComboBoxItem">
							<Border x:Name="Bd"
									Background="{TemplateBinding Background}"
									Padding="{TemplateBinding Padding}">
								<ContentPresenter />
							</Border>
							<ControlTemplate.Triggers>
								<Trigger Property="IsHighlighted" Value="True">
									<Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.HighlightKey}}" />
									<Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.HighlightTextKey}}" />
								</Trigger>
								<Trigger Property="IsSelected" Value="True">
									<Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.HighlightKey}}" />
									<Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.HighlightTextKey}}" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>

			<Style x:Key="ImpactColorItemStyle" TargetType="ComboBoxItem" BasedOn="{StaticResource EditorComboItemStyle}">
				<Style.Triggers>
					<DataTrigger Binding="{Binding}" Value="Allow">
						<Setter Property="Foreground" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.VizSurfaceGreenMediumBrushKey}}" />
					</DataTrigger>
					<DataTrigger Binding="{Binding}" Value="Warn">
						<Setter Property="Foreground" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.VizSurfaceSteelBlueMediumBrushKey}}" />
					</DataTrigger>
					<DataTrigger Binding="{Binding}" Value="RequireApproval">
						<Setter Property="Foreground" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.VizSurfaceGoldMediumBrushKey}}" />
					</DataTrigger>
					<DataTrigger Binding="{Binding}" Value="Block">
						<Setter Property="Foreground" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.VizSurfaceRedMediumBrushKey}}" />
					</DataTrigger>
				</Style.Triggers>
			</Style>

			<DataTemplate x:Key="ImpactColorItemTemplate">
				<TextBlock x:Name="Txt" Text="{Binding}" FontWeight="SemiBold" />
				<DataTemplate.Triggers>
					<DataTrigger Binding="{Binding}" Value="Allow">
						<Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.VizSurfaceGreenMediumBrushKey}}" />
					</DataTrigger>
					<DataTrigger Binding="{Binding}" Value="Warn">
						<Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.VizSurfaceSteelBlueMediumBrushKey}}" />
					</DataTrigger>
					<DataTrigger Binding="{Binding}" Value="RequireApproval">
						<Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.VizSurfaceGoldMediumBrushKey}}" />
					</DataTrigger>
					<DataTrigger Binding="{Binding}" Value="Block">
						<Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.VizSurfaceRedMediumBrushKey}}" />
					</DataTrigger>
				</DataTemplate.Triggers>
			</DataTemplate>

			<Style x:Key="ImpactColorComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource EditorComboStyle}">
				<Setter Property="ItemContainerStyle" Value="{StaticResource ImpactColorItemStyle}" />
				<Setter Property="ItemTemplate" Value="{StaticResource ImpactColorItemTemplate}" />
				<Style.Triggers>
					<DataTrigger Binding="{Binding SelectedItem, RelativeSource={RelativeSource Self}}" Value="Allow">
						<Setter Property="Foreground" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.VizSurfaceGreenMediumBrushKey}}" />
					</DataTrigger>
					<DataTrigger Binding="{Binding SelectedItem, RelativeSource={RelativeSource Self}}" Value="Warn">
						<Setter Property="Foreground" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.VizSurfaceSteelBlueMediumBrushKey}}" />
					</DataTrigger>
					<DataTrigger Binding="{Binding SelectedItem, RelativeSource={RelativeSource Self}}" Value="RequireApproval">
						<Setter Property="Foreground" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.VizSurfaceGoldMediumBrushKey}}" />
					</DataTrigger>
					<DataTrigger Binding="{Binding SelectedItem, RelativeSource={RelativeSource Self}}" Value="Block">
						<Setter Property="Foreground" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.VizSurfaceRedMediumBrushKey}}" />
					</DataTrigger>
				</Style.Triggers>
			</Style>

			<DataTemplate x:Key="ImpactColorModeTemplate">
				<TextBlock x:Name="Txt" Text="{Binding}" FontWeight="SemiBold" />
				<DataTemplate.Triggers>
					<DataTrigger Binding="{Binding}" Value="warn">
						<Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.VizSurfaceSteelBlueMediumBrushKey}}" />
					</DataTrigger>
					<DataTrigger Binding="{Binding}" Value="block">
						<Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.VizSurfaceRedMediumBrushKey}}" />
					</DataTrigger>
				</DataTemplate.Triggers>
			</DataTemplate>

			<Style x:Key="ImpactColorModeItemStyle" TargetType="ComboBoxItem" BasedOn="{StaticResource EditorComboItemStyle}">
				<Style.Triggers>
					<DataTrigger Binding="{Binding}" Value="warn">
						<Setter Property="Foreground" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.VizSurfaceSteelBlueMediumBrushKey}}" />
					</DataTrigger>
					<DataTrigger Binding="{Binding}" Value="block">
						<Setter Property="Foreground" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.VizSurfaceRedMediumBrushKey}}" />
					</DataTrigger>
				</Style.Triggers>
			</Style>

			<Style x:Key="ImpactColorModeComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource EditorComboStyle}">
				<Setter Property="ItemContainerStyle" Value="{StaticResource ImpactColorModeItemStyle}" />
				<Setter Property="ItemTemplate" Value="{StaticResource ImpactColorModeTemplate}" />
				<Style.Triggers>
					<DataTrigger Binding="{Binding SelectedItem, RelativeSource={RelativeSource Self}}" Value="warn">
						<Setter Property="Foreground" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.VizSurfaceSteelBlueMediumBrushKey}}" />
					</DataTrigger>
					<DataTrigger Binding="{Binding SelectedItem, RelativeSource={RelativeSource Self}}" Value="block">
						<Setter Property="Foreground" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.VizSurfaceRedMediumBrushKey}}" />
					</DataTrigger>
				</Style.Triggers>
			</Style>

			<Style x:Key="TabListStyle" TargetType="ListBox">
				<Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}" />
				<Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsshell:VsBrushes.PanelBorderKey}}" />
				<Setter Property="BorderThickness" Value="1" />
				<Setter Property="Padding" Value="4" />
				<Setter Property="HorizontalContentAlignment" Value="Stretch" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="ListBox">
							<Border Background="{TemplateBinding Background}"
									BorderBrush="{TemplateBinding BorderBrush}"
									BorderThickness="{TemplateBinding BorderThickness}"
									CornerRadius="10"
									Padding="{TemplateBinding Padding}">
									<ItemsPresenter />
							</Border>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>

			<Style x:Key="TabItemStyle" TargetType="ListBoxItem">
				<Setter Property="Margin" Value="2,0" />
				<Setter Property="Padding" Value="16,8" />
				<Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}" />
				<Setter Property="Cursor" Value="Hand" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="ListBoxItem">
							<Border x:Name="Bd"
									Background="Transparent"
									CornerRadius="8"
									Padding="{TemplateBinding Padding}">
								<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
							</Border>
							<ControlTemplate.Triggers>
								<Trigger Property="IsSelected" Value="True">
									<Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.AccentMediumKey}}" />
									<Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.HighlightTextKey}}" />
								</Trigger>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.HighlightKey}}" />
									<Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.HighlightTextKey}}" />
								</Trigger>
								<MultiTrigger>
									<MultiTrigger.Conditions>
										<Condition Property="IsSelected" Value="True" />
										<Condition Property="IsMouseOver" Value="True" />
									</MultiTrigger.Conditions>
									<Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.AccentMediumKey}}" />
									<Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.HighlightTextKey}}" />
								</MultiTrigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
		</ResourceDictionary>
	</UserControl.Resources>
	<Grid Margin="8" Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!-- Header -->
		<Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<StackPanel Grid.Column="0" Margin="0,0,20,0">
					<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
						<Image Source="/MSBuildguard.VisualStudio;component/ToolWindows/AppShieldGreen-24x24.png"
							   Width="24"
							   Height="24"
							   Margin="0,0,10,0"
							   VerticalAlignment="Center" />
						<TextBlock Text="MSBuild Guard: Policy Settings" Style="{StaticResource SectionTitleStyle}" Margin="0" />
					</StackPanel>
					<TextBlock Text="Define rules and severity actions that regulate MSBuild project files before execution."
							   Foreground="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}"
							   Margin="0,8,0,8" />

					<StackPanel Orientation="Horizontal" Margin="0,6,0,0">
						<TextBlock Text="Policy file: " FontWeight="SemiBold" Foreground="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}" />
						<TextBlock VerticalAlignment="Center"
								   Style="{StaticResource PolicyPathLinkStyle}"
								   MouseLeftButtonUp="OnPolicyPathClick"
								   ToolTip="Open policy file in editor"
								   Text="{Binding PolicyPathDisplay}" />
					</StackPanel>
				</StackPanel>

				<ListBox Grid.Column="1"
						 Width="380"
						 Height="42"
						 VerticalAlignment="Top"
						 ItemsSource="{Binding AvailablePolicyTypes}"
						 SelectedItem="{Binding PolicyType, Mode=TwoWay}"
						 Style="{StaticResource TabListStyle}"
						 ItemContainerStyle="{StaticResource TabItemStyle}">
					<ListBox.ItemsPanel>
						<ItemsPanelTemplate>
							<StackPanel Orientation="Horizontal" />
						</ItemsPanelTemplate>
					</ListBox.ItemsPanel>
					<ListBox.ItemTemplate>
						<DataTemplate>
							<TextBlock Text="{Binding StringFormat={}{0} Policy}" FontWeight="SemiBold" />
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</Grid>
		</Border>

		<StackPanel Grid.Row="1" Margin="0,12,0,12" Orientation="Horizontal"
					Visibility="{Binding IsProjectDropdownVisible, Converter={StaticResource BoolToVis}}">
			<TextBlock Text="Select Project File"
					   Style="{StaticResource FieldLabelStyle}"
					   VerticalAlignment="Center"
					   Margin="0,0,8,0" />
			<ComboBox MinWidth="360"
					  Style="{StaticResource EditorComboStyle}"
					  Margin="0"
					  ItemsSource="{Binding AvailableProjects}"
					  SelectedItem="{Binding SelectedProject, Mode=TwoWay}">
				<ComboBox.ItemTemplate>
					<DataTemplate>
						<TextBlock Text="{Binding Name}" />
					</DataTemplate>
				</ComboBox.ItemTemplate>
			</ComboBox>
		</StackPanel>

		<!-- Settings -->
		<ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
			<StackPanel>
				<Grid Margin="0,0,0,12">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="12" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>

					<Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
						<StackPanel>
							<TextBlock Text="⚙ General Configurations" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>
							<Separator Background="{DynamicResource {x:Static vsshell:VsBrushes.PanelBorderKey}}" Margin="0,0,0,12" />

							<TextBlock Text="Policy Enforcement Mode" Style="{StaticResource FieldLabelStyle}" />
							<ComboBox Style="{StaticResource ImpactColorModeComboBoxStyle}"
									  ItemsSource="{Binding AvailableModes}"
									  SelectedItem="{Binding Mode}" />

							<Border Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}" BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.PanelBorderKey}}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
								<StackPanel>
									<CheckBox IsChecked="{Binding BaselineRequired}" Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}" FontWeight="SemiBold" Content="Require Trusted Baseline" />
									<TextBlock Text="Block/warn on any new findings missing from baseline.json" Foreground="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}" Margin="20,2,0,0" />
								</StackPanel>
							</Border>

							<Border Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}" BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.PanelBorderKey}}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,0">
								<StackPanel>
									<CheckBox IsChecked="{Binding StrictMode}" Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}" FontWeight="SemiBold" Content="Enable strict analysis" />
									<TextBlock Text="Escalate severity if validation signatures are missing" Foreground="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}" Margin="20,2,0,0" />
								</StackPanel>
							</Border>
						</StackPanel>
					</Border>

					<Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
						<StackPanel>
							<TextBlock Text="🛠 Build-Time Actions" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>
							<Separator Background="{DynamicResource {x:Static vsshell:VsBrushes.PanelBorderKey}}" Margin="0,0,0,12" />

							<TextBlock Text="Incomplete Analysis Behavior" Style="{StaticResource FieldLabelStyle}" />
							<ComboBox Style="{StaticResource ImpactColorComboBoxStyle}"
									  ItemsSource="{Binding AvailableActions}"
									  SelectedItem="{Binding IncompleteAnalysisAction}" />

							<TextBlock Text="Unapproved NuGet Sources Action" Style="{StaticResource FieldLabelStyle}" />
							<ComboBox Style="{StaticResource ImpactColorComboBoxStyle}" Margin="0,0,0,0"
									  ItemsSource="{Binding AvailableActions}"
									  SelectedItem="{Binding UnapprovedPackageSourceAction}" />
						</StackPanel>
					</Border>
				</Grid>

				<Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
					<StackPanel>
						<TextBlock Text="📊 Minimum Enforcement Action by Severity" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
						<Separator Background="{DynamicResource {x:Static vsshell:VsBrushes.PanelBorderKey}}" Margin="0,0,0,14" />

						<UniformGrid Columns="5" Rows="1" Name="SeverityUniformGrid">
							<Border Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}" BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.PanelBorderKey}}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="4,0">
								<StackPanel>
									<Border Height="3" Background="{DynamicResource {x:Static platformUi:EnvironmentColors.VizSurfaceRedMediumBrushKey}}" CornerRadius="2" Margin="0,-10,-10,8" HorizontalAlignment="Stretch" />
									<TextBlock Text="CRITICAL" Foreground="{DynamicResource {x:Static platformUi:EnvironmentColors.VizSurfaceRedMediumBrushKey}}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8" />
									<ComboBox Style="{StaticResource ImpactColorComboBoxStyle}" Margin="0"
											  ItemsSource="{Binding AvailableActions}"
											  SelectedItem="{Binding CriticalAction}" />
								</StackPanel>
							</Border>

							<Border Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}" BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.PanelBorderKey}}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="4,0">
								<StackPanel>
									<Border Height="3" Background="{DynamicResource {x:Static platformUi:EnvironmentColors.VizSurfaceDarkGoldMediumBrushKey}}" CornerRadius="2" Margin="0,-10,-10,8" HorizontalAlignment="Stretch" />
									<TextBlock Text="HIGH" Foreground="{DynamicResource {x:Static platformUi:EnvironmentColors.VizSurfaceDarkGoldMediumBrushKey}}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8" />
									<ComboBox Style="{StaticResource ImpactColorComboBoxStyle}" Margin="0"
											  ItemsSource="{Binding AvailableActions}"
											  SelectedItem="{Binding HighAction}" />
								</StackPanel>
							</Border>

							<Border Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}" BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.PanelBorderKey}}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="4,0">
								<StackPanel>
									<Border Height="3" Background="{DynamicResource {x:Static platformUi:EnvironmentColors.VizSurfaceGoldMediumBrushKey}}" CornerRadius="2" Margin="0,-10,-10,8" HorizontalAlignment="Stretch" />
									<TextBlock Text="MEDIUM" Foreground="{DynamicResource {x:Static platformUi:EnvironmentColors.VizSurfaceGoldMediumBrushKey}}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8" />
									<ComboBox Style="{StaticResource ImpactColorComboBoxStyle}" Margin="0"
											  ItemsSource="{Binding AvailableActions}"
											  SelectedItem="{Binding MediumAction}" />
								</StackPanel>
							</Border>

							<Border Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}" BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.PanelBorderKey}}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="4,0">
								<StackPanel>
									<Border Height="3" Background="{DynamicResource {x:Static platformUi:EnvironmentColors.VizSurfaceSteelBlueMediumBrushKey}}" CornerRadius="2" Margin="0,-10,-10,8" HorizontalAlignment="Stretch" />
									<TextBlock Text="LOW" Foreground="{DynamicResource {x:Static platformUi:EnvironmentColors.VizSurfaceSteelBlueMediumBrushKey}}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8" />
									<ComboBox Style="{StaticResource ImpactColorComboBoxStyle}" Margin="0"
											  ItemsSource="{Binding AvailableActions}"
											  SelectedItem="{Binding LowAction}" />
								</StackPanel>
							</Border>

							<Border Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}" BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.PanelBorderKey}}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="4,0">
								<StackPanel>
									<Border Height="3" Background="{DynamicResource {x:Static platformUi:EnvironmentColors.VizSurfaceGreenMediumBrushKey}}" CornerRadius="2" Margin="0,-10,-10,8" HorizontalAlignment="Stretch" />
									<TextBlock Text="INFO" Foreground="{DynamicResource {x:Static platformUi:EnvironmentColors.VizSurfaceGreenMediumBrushKey}}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8" />
									<ComboBox Style="{StaticResource ImpactColorComboBoxStyle}" Margin="0"
											  ItemsSource="{Binding AvailableActions}"
											  SelectedItem="{Binding InfoAction}" />
								</StackPanel>
							</Border>
						</UniformGrid>
					</StackPanel>
				</Border>
			</StackPanel>
		</ScrollViewer>

		<!-- Footer action bar -->
		<Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Padding="18,14">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
					<Ellipse Width="10" Height="10" Fill="{DynamicResource {x:Static platformUi:EnvironmentColors.VizSurfaceGreenMediumBrushKey}}" Margin="0,0,10,0" />
					<TextBlock Text="{Binding StatusMessage}"
							   Foreground="{DynamicResource {x:Static platformUi:EnvironmentColors.VizSurfaceGreenMediumBrushKey}}"
							   TextTrimming="CharacterEllipsis"
							   VerticalAlignment="Center" />
				</StackPanel>

				<Button Grid.Column="1"
						Content="💾 Save &amp; Sign Policy"
						Click="OnSaveClick"
						Foreground="{DynamicResource {x:Static vsshell:VsBrushes.HighlightTextKey}}"
						Background="{DynamicResource {x:Static platformUi:EnvironmentColors.VizSurfaceGreenMediumBrushKey}}"
						BorderThickness="0"
						Padding="24,10"
						FontSize="16"
						FontWeight="SemiBold"
						Cursor="Hand">
					<Button.Template>
						<ControlTemplate TargetType="Button">
							<Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
								<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
							</Border>
						</ControlTemplate>
					</Button.Template>
				</Button>
			</Grid>
		</Border>
	</Grid>
</UserControl>
