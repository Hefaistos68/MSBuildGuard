<UserControl x:Class="MSBuildGuard.VisualStudio.ToolWindows.PolicyEditorControl"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
			 mc:Ignorable="d"
			 d:DesignHeight="600"
			 d:DesignWidth="700">
	<UserControl.Resources>
		<ResourceDictionary>
			<BooleanToVisibilityConverter x:Key="BoolToVis" />
			<Style TargetType="TextBlock">
				<Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>
			</Style>
			<Style x:Key="PolicyPathLinkStyle" TargetType="TextBlock">
				<Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ControlLinkTextKey}}"/>
				<Setter Property="TextDecorations" Value="Underline"/>
				<Setter Property="Cursor" Value="Hand"/>
				<Style.Triggers>
					<Trigger Property="IsMouseOver" Value="True">
						<Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ControlLinkTextHoverKey}}"/>
					</Trigger>
				</Style.Triggers>
			</Style>
			<!-- Theming standard controls for VS Tool Windows -->
			<Style TargetType="ComboBox" BasedOn="{StaticResource {x:Static vsshell:VsResourceKeys.ComboBoxStyleKey}}" />
			<Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Static vsshell:VsResourceKeys.ComboBoxItemStyleKey}}" />
			<Style TargetType="CheckBox" BasedOn="{StaticResource {x:Static vsshell:VsResourceKeys.CheckBoxStyleKey}}" />
		</ResourceDictionary>
	</UserControl.Resources>
	<Grid Margin="12" Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!-- Header -->
		<StackPanel Orientation="Horizontal" Margin="8,0,-1,0">
			<Image Source="/MSBuildguard.VisualStudio;component/ToolWindows/AppShieldGreen-24x24.png"
				   Width="24"
				   Height="24"
				   Margin="4,4,12,0"
				   VerticalAlignment="Top" HorizontalAlignment="Left"/>

			<TextBlock Text="MSBuild Guard - Policy Editor ("
					   FontSize="18"
					   FontWeight="SemiBold"
					   Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" Margin="0,4,0,0" />
			<TextBlock Text="{Binding PolicyTypeLabel}"
					   FontSize="18"
					   FontWeight="SemiBold"
					   Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" Margin="0,4,0,0" />
			<TextBlock Text=")"
					   FontSize="18"
					   FontWeight="SemiBold"
					   Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" Margin="0,4,0,0" />
		</StackPanel>

		<!-- Policy file path -->
		<StackPanel Grid.Row="1" Orientation="Horizontal" Margin="8,10,0,10">
			<TextBlock Text="Policy type:" FontWeight="Bold" VerticalAlignment="Center" />
			<ComboBox Width="110"
					  Margin="6,0,16,0"
					  ItemsSource="{Binding AvailablePolicyTypes}"
					  SelectedItem="{Binding PolicyType, Mode=TwoWay}" />
			<TextBlock Text="Project:"
					   FontWeight="Bold"
					   VerticalAlignment="Center"
					   Visibility="{Binding IsProjectDropdownVisible, Converter={StaticResource BoolToVis}}" />
			<ComboBox Width="200"
					  Margin="6,0,16,0"
					  ItemsSource="{Binding AvailableProjects}"
					  SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
					  DisplayMemberPath="Name"
					  Visibility="{Binding IsProjectDropdownVisible, Converter={StaticResource BoolToVis}}" />
			<TextBlock Text="Policy file:" FontWeight="Bold" VerticalAlignment="Center" />
			<TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
					   Style="{StaticResource PolicyPathLinkStyle}"
					   MouseLeftButtonUp="OnPolicyPathClick"
					   ToolTip="Open policy file in editor"
					   Text="{Binding PolicyPathDisplay}" />
		</StackPanel>

		<!-- Settings -->
		<ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
			<StackPanel>

				<!-- General settings -->
				<GroupBox Header="General" Margin="0,0,0,10"
						  Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}">
					<Grid Margin="6">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="220" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="20" />
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>

						<TextBlock Text="Mode:" VerticalAlignment="Center" Margin="0,4" />
						<ComboBox Grid.Column="1" Margin="0,4"
								  ItemsSource="{Binding AvailableModes}"
								  SelectedItem="{Binding Mode}" />
						<TextBlock Grid.Column="2" Text="ℹ️"
								   ToolTip="Choose whether policy outcomes are advisory (warn) or intended for blocking workflows." 
								   VerticalAlignment="Center" />

						<TextBlock Grid.Row="1" Text="Baseline required:" VerticalAlignment="Center" Margin="0,4" />
						<CheckBox Grid.Row="1" Grid.Column="1" Margin="0,4"
								  IsChecked="{Binding BaselineRequired}"
								  VerticalAlignment="Center" />
						<TextBlock Grid.Row="1" Grid.Column="2" Text="ℹ️"
								   ToolTip="Require an approved baseline before scans can be considered trusted." 
								   VerticalAlignment="Center" />

						<TextBlock Grid.Row="2" Text="Strict mode:" VerticalAlignment="Center" Margin="0,4" />
						<CheckBox Grid.Row="2" Grid.Column="1" Margin="0,4"
								  IsChecked="{Binding StrictMode}"
								  VerticalAlignment="Center" />
						<TextBlock Grid.Row="2" Grid.Column="2" Text="ℹ️"
								   ToolTip="Escalate incomplete or uncertain analysis outcomes to stricter enforcement." 
								   VerticalAlignment="Center" />

						<TextBlock Grid.Row="3" Text="Incomplete analysis action:" VerticalAlignment="Center" Margin="0,4" />
						<ComboBox Grid.Row="3" Grid.Column="1" Margin="0,4"
								  ItemsSource="{Binding AvailableActions}"
								  SelectedItem="{Binding IncompleteAnalysisAction}" />
						<TextBlock Grid.Row="3" Grid.Column="2" Text="ℹ️"
								   ToolTip="Set the minimum action when files cannot be fully analyzed." 
								   VerticalAlignment="Center" />

						<TextBlock Grid.Row="4" Text="Unapproved package source action:" VerticalAlignment="Center" Margin="0,4" />
						<ComboBox Grid.Row="4" Grid.Column="1" Margin="0,4"
								  ItemsSource="{Binding AvailableActions}"
								  SelectedItem="{Binding UnapprovedPackageSourceAction}" />
						<TextBlock Grid.Row="4" Grid.Column="2" Text="ℹ️"
								   ToolTip="Set how findings from packages with unknown or unapproved sources are handled." 
								   VerticalAlignment="Center" />
					</Grid>
				</GroupBox>

				<!-- Minimum action by severity -->
				<GroupBox Header="Minimum action by severity" Margin="0,0,0,10"
						  Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}">
					<Grid Margin="6">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="220" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>

						<TextBlock Text="Info:" VerticalAlignment="Center" Margin="0,4" />
						<ComboBox Grid.Column="1" Margin="0,4"
								  ItemsSource="{Binding AvailableActions}"
								  SelectedItem="{Binding InfoAction}" />

						<TextBlock Grid.Row="1" Text="Low:" VerticalAlignment="Center" Margin="0,4" />
						<ComboBox Grid.Row="1" Grid.Column="1" Margin="0,4"
								  ItemsSource="{Binding AvailableActions}"
								  SelectedItem="{Binding LowAction}" />

						<TextBlock Grid.Row="2" Text="Medium:" VerticalAlignment="Center" Margin="0,4" />
						<ComboBox Grid.Row="2" Grid.Column="1" Margin="0,4"
								  ItemsSource="{Binding AvailableActions}"
								  SelectedItem="{Binding MediumAction}" />

						<TextBlock Grid.Row="3" Text="High:" VerticalAlignment="Center" Margin="0,4" />
						<ComboBox Grid.Row="3" Grid.Column="1" Margin="0,4"
								  ItemsSource="{Binding AvailableActions}"
								  SelectedItem="{Binding HighAction}" />

						<TextBlock Grid.Row="4" Text="Critical:" VerticalAlignment="Center" Margin="0,4" />
						<ComboBox Grid.Row="4" Grid.Column="1" Margin="0,4"
								  ItemsSource="{Binding AvailableActions}"
								  SelectedItem="{Binding CriticalAction}" />
					</Grid>
				</GroupBox>

			</StackPanel>
		</ScrollViewer>

		<!-- Save button row -->
		<StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,8,4">
			<Button Content="Save" Width="80" Click="OnSaveClick" />
		</StackPanel>

		<!-- Status bar -->
		<TextBlock Grid.Row="4"
				   Text="{Binding StatusMessage}"
				   Foreground="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}"
				   TextTrimming="CharacterEllipsis" Margin="4,0,0,0" />
	</Grid>
</UserControl>


