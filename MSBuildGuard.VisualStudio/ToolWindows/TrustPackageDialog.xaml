<platformUi:DialogWindow x:Class="MSBuildGuard.VisualStudio.ToolWindows.TrustPackageDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:platformUi="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             mc:Ignorable="d"
             Title="Trust NuGet Package"
             SizeToContent="WidthAndHeight"
             ResizeMode="NoResize"
             WindowStartupLocation="CenterOwner"
             Loaded="Window_Loaded"
             Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}"
             Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"
             platformUi:ThemedDialogStyleLoader.UseDefaultThemedDialogStyles="True">
    <platformUi:DialogWindow.Resources>
        <ResourceDictionary>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"/>
            </Style>
            <Style TargetType="Expander">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"/>
                <Setter Property="Background" Value="Transparent"/>
            </Style>
            <Style TargetType="DatePicker">
                <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.ComboBoxBackgroundKey}}"/>
                <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsshell:VsBrushes.ComboBoxBorderKey}}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="2"/>
                <Style.Resources>
                    <Style TargetType="DatePickerTextBox">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.ComboBoxMouseOverGlyphKey}}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Style.Resources>
            </Style>
            <Style TargetType="Calendar">
                <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}"/>
                <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsshell:VsBrushes.PanelBorderKey}}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>
            <Style TargetType="CalendarItem">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Style>
            <Style TargetType="CalendarDayButton">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.HighlightKey}}"/>
                        <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.HighlightTextKey}}"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.GridHeadingBackgroundKey}}"/>
                    </Trigger>
                    <Trigger Property="IsBlackedOut" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}"/>
                        <Setter Property="Opacity" Value="0.5"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="CalendarButton">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.GridHeadingBackgroundKey}}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </platformUi:DialogWindow.Resources>
    <StackPanel Margin="16" Width="640">
        <TextBlock Text="Trust NuGet Package" FontSize="16" FontWeight="Bold" Margin="0,0,0,16"/>

        <TextBlock Text="You are about to trust the following NuGet package. All findings originating from this package will be automatically approved based on its folder hash integrity." TextWrapping="Wrap" Margin="0,0,0,12"/>

        <Border Background="{DynamicResource {x:Static vsshell:VsBrushes.GridHeadingBackgroundKey}}" Padding="12" Margin="0,0,0,12" CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Package ID:" FontWeight="Bold" Margin="0,0,8,8"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="PackageIdTextBlock" Text="" Margin="0,0,0,8" TextWrapping="Wrap"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Version:" FontWeight="Bold" Margin="0,0,8,8"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="PackageVersionTextBlock" Text="" Margin="0,0,0,8" TextWrapping="Wrap"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Path:" FontWeight="Bold" Margin="0,0,8,8"/>
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="PackagePathTextBlock" Text="" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Folder Hash:" FontWeight="Bold" Margin="0,0,8,0"/>
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="PackageHashTextBlock" Text="Calculating..." TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"/>
            </Grid>
        </Border>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Scope:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,8,0" Width="50"/>
            <ComboBox x:Name="ScopeComboBox" Width="180" SelectedIndex="0" SelectionChanged="ScopeComboBox_SelectionChanged"/>
        </StackPanel>

        <StackPanel x:Name="ProjectSelectorPanel" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,0,12">
            <TextBlock Text="Project:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,8,0" Width="50"/>
            <ComboBox x:Name="ProjectComboBox" Width="360" DisplayMemberPath="Name" SelectedValuePath="Path"/>
        </StackPanel>

        <Expander Header="Advanced" IsExpanded="False" Margin="0,0,0,12">
            <StackPanel Margin="12,8,12,4">
                <CheckBox x:Name="NoExpirationCheckBox" Content="Does not expire" Margin="0,0,0,8" IsChecked="True" Checked="NoExpirationCheckBox_Changed" Unchecked="NoExpirationCheckBox_Changed"/>
                <TextBlock Text="Valid until:" FontWeight="Bold" Margin="0,0,0,6"/>
                <DatePicker x:Name="ValidUntilDatePicker" IsEnabled="False"/>
            </StackPanel>
        </Expander>

        <TextBlock Text="Reason (optional):" FontWeight="Bold" Margin="0,0,0,8"/>
        <TextBox x:Name="ReasonTextBox" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,16" Padding="8"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="TrustButton" Content="Trust Package" Padding="16,8" Margin="0,0,8,0" IsEnabled="False" Click="TrustButton_Click"/>
            <Button x:Name="CancelButton" Content="Cancel" Padding="16,8" Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</platformUi:DialogWindow>
