<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable">
	<Extern href="stdidcmd.h" />
	<Extern href="vsshlids.h" />
	<Commands package="guidContextDiffExtensionPackage">
		<Groups>
			<Group guid="guidContextDiffExtensionCmdSet" id="SolutionExplorerGroup" priority="0x0100">
				<Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_ITEMNODE" />
			</Group>
			<Group guid="guidContextDiffExtensionCmdSet" id="ToolsMenuGroup" priority="0x0100">
				<Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_TOOLS" />
			</Group>
		</Groups>

		<Buttons>
			<Button guid="guidContextDiffExtensionCmdSet" id="OpenContextDiff" priority="0x0100" type="Button">
				<Parent guid="guidContextDiffExtensionCmdSet" id="SolutionExplorerGroup" />
				<Icon guid="guidContextDiffImages" id="bmpPic1" />
				<CommandFlag>DynamicVisibility</CommandFlag>
				<CommandFlag>DefaultInvisible</CommandFlag>
				<Strings>
					<ButtonText>Compare with Context Diff</ButtonText>
				</Strings>
			</Button>
			<Button guid="guidContextDiffExtensionCmdSet" id="CompareFilesCommand" priority="0x0100" type="Button">
				<Parent guid="guidContextDiffExtensionCmdSet" id="ToolsMenuGroup" />
				<Icon guid="guidContextDiffImages" id="bmpPic1" />
				<Strings>
					<ButtonText>Compare Files (Context Diff)...</ButtonText>
				</Strings>
			</Button>
		</Buttons>

		<Bitmaps>
			<Bitmap guid="guidContextDiffImages" href="Resources\Compare.ico" usedList="bmpPic1" />
		</Bitmaps>
	</Commands>

	<Symbols>
		<GuidSymbol name="guidContextDiffExtensionPackage" value="a61ce508-fb5e-40e7-b02d-ae85fb47e08f" />
		<GuidSymbol name="guidContextDiffImages" value="c1d4718d-4b55-46d2-86d6-f7d51450ac4d">
			<IDSymbol name="bmpPic1" value="1" />
		</GuidSymbol>
		<GuidSymbol name="guidContextDiffExtensionCmdSet" value="d2c4c69f-75f2-4d6d-84f7-8b8d8c5c6b3f">
			<IDSymbol name="SolutionExplorerGroup" value="0x1020" />
			<IDSymbol name="ToolsMenuGroup" value="0x1021" />
			<IDSymbol name="OpenContextDiff" value="0x0100" />
			<IDSymbol name="CompareFilesCommand" value="0x0101" />
		</GuidSymbol>
	</Symbols>
</CommandTable>
